# 1. Supabase PostgreSQL Database (Required for persistent reviews)
# Found in Supabase Dashboard -> Project Settings -> API:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE ON EMAIL NOTIFICATIONS (To bluelineautosuk@gmail.com):
# For security, email provider credentials (such as RESEND_API_KEY) must NEVER
# be stored in this client-facing .env file.
# Instead, store them securely in your Supabase backend secrets:
# Run: supabase secrets set RESEND_API_KEY=re_your_api_key
# Or in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
